##################################################################
!#                      Terminal Type & Encoding                 #
!##################################################################
! Set terminal type and encoding (enables 256-color support)
xterm*termName                  : xterm-256color

!##################################################################
!#                            Font Settings                       #
!##################################################################
! Set the font family and size
xterm*faceName                  : Caskaydia Cove Nerd Font
xterm*faceSize                  : 10.25

! Enable font rendering and anti-aliasing for better appearance
xterm*renderFont                : true
xterm*fontAntiAlias             : true

! Disable bold font rendering to avoid flicker
xterm*allowBoldFonts            : false

! Alternative font (useful for legibility or fallback)
xterm*font2                     : -xos4-terminus-medium-r-normal-*-14-*-*-*-*-*-iso10646-1

! Always draw its own line‑drawing glyphs instead of relying on font
xterm*vt100*font-linedrawing    : true

! Assume fonts lack the ACS glyphs so fall‑back drawing is used in every case
xterm*vt100*forceBoxChars       : true

!##################################################################
!#                        Window Behavior                        #
!##################################################################
! Always keep the terminal window on top of others
!xterm*alwaysOnTop               : true

! Window resizing behavior (controls how the window resizes)
!xterm*resizeGravity             : NorthWestGravity
!xterm*maximized                 : true

!##################################################################
!#                          Bell Settings                         #
!##################################################################
! Visual bell (flashes the screen instead of producing a sound)
xterm*visualBell                : true
xterm*bellIsUrgent              : true

!##################################################################
!#                     Keybinding Customizations                 #
!##################################################################
! Customize keybindings for font resizing and clipboard actions
xterm*VT100.Translations        : #override \
    Ctrl <Key> minus            : smaller-vt-font() \n\
    Ctrl <Key> plus             : larger-vt-font() \n\
    Ctrl <Key> 0                : set-vt-font(d) \n\
    Shift <KeyPress> Insert     : insert-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V           : insert-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>C           : copy-selection(CLIPBOARD) \n\
    Ctrl <Btn1Up>               : exec-formatted("xdg-open '%t'", PRIMARY)

!##################################################################
!#                      Selection & Clipboard                    #
!##################################################################
! Enable clipboard support and automatic selection copying
xterm*selectToClipboard         : true

! Highlight and trim selected text
xterm*highlightSelection        : true
xterm*trimSelection             : true

! Define the clipboard selection mode (Clipboard is default)
xterm*allowTitleOps             : true

!##################################################################
!#                      Scrollback & Mouse Behavior               #
!##################################################################
! Set the scrollback buffer size (number of lines stored in history)
xterm*saveLines                 : 4096

! Enable smooth scrolling with the keyboard
xterm*scrollKey                 : true

! Enable mouse support for selection and scrolling
xterm*allowMouseOps             : true
xterm*pointerMode               : 0

!##################################################################
!#                        Cursor Settings                         #
!##################################################################
! Set cursor to be an underline and make it blink
xterm*cursorUnderline           : false
xterm*cursorBlink               : true

xterm*charClass: 33:48,36-47:48,58-59:48,61:48,63-64:48,95:48,126:48

!##################################################################
!#                          Color Scheme                          #
!##################################################################
! Enable true color (24-bit) support for a wide range of colors
xterm*trueColor                 : true

! Define background and foreground colors
xterm*background                : #282A36
xterm*foreground                : #F8F8F2

! Define color palette (from your custom colors)
xterm*color0                    : #21222C
xterm*color1                    : #FF5555
xterm*color2                    : #50FA7B
xterm*color3                    : #F1FA8C
xterm*color4                    : #BD93F9
xterm*color5                    : #FF79C6
xterm*color6                    : #8BE9FD
xterm*color7                    : #44475A
xterm*color8                    : #6272A4
xterm*color9                    : #FF5555
xterm*color10                   : #50FA7B
xterm*color11                   : #F1FA8C
xterm*color12                   : #BD93F9
xterm*color13                   : #FF79C6
xterm*color14                   : #8BE9FD
xterm*color15                   : #F8F8F2

// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": 0,
  "spacing": 0,
  "expand-left": true,
  "reload_style_on_change": true,

  "modules-left": ["sway/workspaces", "custom/separator", "sway/window"],

  "modules-right": [
    //"mpris",
    //"custom/mpris-separator",
    "tray",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "memory",
    "custom/separator",
    "cpu",
    "custom/separator",
    "battery",
    "custom/separator",
    "clock",
  ],

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },

  "sway/window": {
    "format": "{}",
    "expand": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Chromium": "$1",
    },
  },

  "mpris": {
    "format": "{status_icon} {artist} — {title}",
    "format-stopped": "",
    "tooltip-format": "Player: {player}\nStatus: {status}\nArtist: {artist}\nTitle: {title}\nAlbum: {album}",
    "artist-len": 24,
    "title-len": 40,
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛",
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
  },

  "custom/mpris-separator": {
    "exec": "playerctl status 2>/dev/null | grep -qv '^Stopped$' && printf ''",
    "interval": 1,
    "tooltip": false,
  },

  "custom/separator": {
    "format": "",
    "tooltip": false,
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}\nVolume: {volume}%",
  },

  "memory": {
    "interval": 2,
    "format": "  {percentage}%",
    "tooltip-format": "Used: {used:0.1f} GiB / {total:0.1f} GiB",
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip": true,
  },

  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰚥 {icon} {capacity}%",
    "format-plugged": "󰚥 {icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    //"on-scroll-up": "$HOME/.config/waybar/scripts/brightness-osd up",
    //"on-scroll-down": "$HOME/.config/waybar/scripts/brightness-osd down",
    "tooltip-format": "Battery: {capacity}%",
  },

  "clock": {
    "interval": 30,
    "format": "{:%I:%M %p}",
    "format-alt": "{:%a %b %d %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
    },
  },
}
